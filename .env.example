VITE_API_BASE_URL=http://localhost:4000

# Same Google OAuth client ID as backend/.env's GOOGLE_CLIENT_ID. Without it,
# the "Sign in with Google" button on /signup and /login just doesn't render.
VITE_GOOGLE_CLIENT_ID=

# Google reCAPTCHA v3 site key (public, pairs with backend/.env's
# RECAPTCHA_SECRET_KEY — same reCAPTCHA site, different keys). Without it, the
# frontend just doesn't attach a verification token, and the backend skips
# checking for one.
VITE_RECAPTCHA_SITE_KEY=

# Set to "true" to gate the whole customer-facing site behind a "coming
# soon" page. The admin dashboard (/admin) stays reachable either way.
VITE_COMING_SOON=false

# Optional AES-256-GCM obfuscation of JSON API payloads, on top of HTTPS.
# Pairs with backend/.env's PAYLOAD_OBFUSCATION_ENABLED / PAYLOAD_OBFUSCATION_KEY
# — same 32-byte key (base64 or hex), both sides toggled together.
#
# NOT a secret: every VITE_* var is inlined into the built JS, so this key is
# readable by anyone in DevTools. It only obscures payloads from casual
# on-the-wire inspection (proxies, logs); it gives no confidentiality against
# the end user. TLS is the actual transport security.
VITE_PAYLOAD_OBFUSCATION_ENABLED=false
VITE_PAYLOAD_OBFUSCATION_KEY=
