VITE_API_BASE_URL=http://localhost:4000

# Same Google OAuth client ID as backend/.env's GOOGLE_CLIENT_ID. Without it,
# the "Sign in with Google" button on /signup and /login just doesn't render.
VITE_GOOGLE_CLIENT_ID=

# Google reCAPTCHA v3 site key (public, pairs with backend/.env's
# RECAPTCHA_SECRET_KEY — same reCAPTCHA site, different keys). Without it, the
# frontend just doesn't attach a verification token, and the backend skips
# checking for one.
VITE_RECAPTCHA_SITE_KEY=
